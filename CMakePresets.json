{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": { "PATH": "/usr/local/bin:/usr/bin:$penv{PATH}" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "asan",
      "displayName": "Debug + AddressSanitizer",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SPINUS_ENABLE_ASAN": "ON" }
    },
    {
      "name": "windows-cross",
      "displayName": "Windows x64, cross-built on Linux (clang-cl + xwin)",
      "inherits": "base",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "toolchainFile": "${sourceDir}/cmake/toolchains/windows-msvc-xwin.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "SPINUS_BUILD_OWN_PLUGINS": "OFF",
        "SPINUS_BUILD_SURGE": "OFF",
        "SPINUS_BUILD_BUNDLED_PLUGINS": "OFF",
        "SPINUS_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "windows",
      "displayName": "Windows x64, on Windows (Visual Studio Build Tools)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "SPINUS_BUILD_SURGE": "OFF",
        "SPINUS_BUILD_BUNDLED_PLUGINS": "OFF",
        "SPINUS_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "configurePreset": "release", "inheritConfigureEnvironment": true },
    { "name": "debug", "configurePreset": "debug", "inheritConfigureEnvironment": true },
    { "name": "asan", "configurePreset": "asan", "inheritConfigureEnvironment": true },
    { "name": "windows-cross", "configurePreset": "windows-cross", "inheritConfigureEnvironment": true },
    { "name": "windows", "configurePreset": "windows" }
  ],
  "testPresets": [
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "asan", "configurePreset": "asan", "output": { "outputOnFailure": true } }
  ]
}
