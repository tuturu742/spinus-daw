# Checks run in CI on Spinus code (src/, app/, tests/). Third-party headers are excluded.
# Left out: throwing-static-initialization (file-scope constants such as a juce::File can only throw when
# memory runs out at start). Optional access through value() is checked: it throws.
Checks: >
  -*,
  bugprone-*,
  -bugprone-easily-swappable-parameters,
  -bugprone-exception-escape,
  -bugprone-throwing-static-initialization,
  cppcoreguidelines-slicing,
  cppcoreguidelines-virtual-class-destructor,
  misc-redundant-expression,
  misc-unused-using-decls,
  modernize-use-override,
  modernize-use-nullptr,
  performance-*,
  -performance-enum-size,
  readability-container-size-empty,
  readability-redundant-smartptr-get
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(src|app|tests)/.*'
ExcludeHeaderFilterRegex: '.*/(external|build)/.*'
CheckOptions:
  bugprone-unchecked-optional-access.IgnoreValueCalls: true
