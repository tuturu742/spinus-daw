pkgbase = spinus-git
	pkgdesc = A Linux-first, FL Studio-style digital audio workstation
	pkgver = 0.1.0alpha3
	pkgrel = 1
	url = https://github.com/tuturu742/spinus-daw
	arch = x86_64
	license = AGPL-3.0-or-later
	license = ISC
	license = MIT
	license = BSD-3-Clause
	makedepends = cmake
	makedepends = git
	makedepends = mesa
	makedepends = ninja
	makedepends = pkgconf
	makedepends = python
	depends = alsa-lib
	depends = cairo
	depends = curl
	depends = fontconfig
	depends = freetype2
	depends = gcc-libs
	depends = glibc
	depends = libarchive
	depends = libglvnd
	depends = libsndfile
	depends = libx11
	depends = libxcursor
	depends = libxext
	depends = libxinerama
	depends = libxrandr
	depends = libxrender
	depends = jack
	depends = rubberband
	depends = ttf-font
	optdepends = pipewire-jack: low-latency audio through PipeWire (recommended)
	optdepends = python-httpx: AI features (off until turned on in Options > AI)
	optdepends = python-keyring: storing AI connection keys in the system keyring
	optdepends = python-onnxruntime-cpu: local embedding models for manual search (with python-numpy)
	optdepends = python-numpy: hum, sing or beatbox an idea to notes; local embedding models for manual search
	optdepends = uv: installing the analysis engine (PyTorch) for song analysis
	optdepends = lame: MP3 export
	optdepends = ffmpeg: M4A, AAC and other audio files; AAC export
	optdepends = surge-xt-clap: Surge XT from the Arch repositories, instead of downloading it
	optdepends = lsp-plugins-clap: LSP Plugins from the Arch repositories, instead of downloading them
	optdepends = dragonfly-reverb-clap: Dragonfly Reverb from the Arch repositories, instead of downloading it
	optdepends = xdg-desktop-portal: your desktop's own file dialogs (KDE Plasma and GNOME install it)
	provides = spinus
	conflicts = spinus
	source = spinus-daw::git+https://github.com/tuturu742/spinus-daw.git
	sha256sums = SKIP

pkgname = spinus-git
