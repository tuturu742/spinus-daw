# The AppImage builder: Ubuntu 24.04, so the AppImage runs on any Linux with glibc 2.39 or
# newer (Arch, Fedora 40+, Ubuntu 24.04+, Debian 13+). Tools are pinned and checked against their
# published SHA-256.
FROM docker.io/library/ubuntu:24.04

RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build git pkg-config python3 file ca-certificates curl \
        libasound2-dev libjack-jackd2-dev libxi-dev ladspa-sdk libglu1-mesa-dev libfreetype-dev libfontconfig1-dev libx11-dev libxcomposite-dev libxcursor-dev \
        libxext-dev libxinerama-dev libxrandr-dev libxrender-dev libgl-dev libcurl4-openssl-dev \
        libarchive-dev librubberband-dev libsndfile1-dev desktop-file-utils patchelf squashfs-tools \
    && rm -rf /var/lib/apt/lists/*

ARG LINUXDEPLOY=1-alpha-20251107-1
ARG LINUXDEPLOY_SHA256=c20cd71e3a4e3b80c3483cef793cda3f4e990aca14014d23c544ca3ce1270b4d
ARG APPIMAGETOOL=1.9.1
ARG APPIMAGETOOL_SHA256=ed4ce84f0d9caff66f50bcca6ff6f35aae54ce8135408b3fa33abfc3cb384eb0
ARG UV=0.12.24
ARG UV_SHA256=b4dfaef47d491a7296981f8374a4595f55dbf84e8937c8ecd2983574d8bb3da6

# AppImages need FUSE to run; unpacked once here, the tools run without it.
RUN cd /opt \
    && curl -fsSLo linuxdeploy.AppImage "https://github.com/linuxdeploy/linuxdeploy/releases/download/${LINUXDEPLOY}/linuxdeploy-x86_64.AppImage" \
    && echo "${LINUXDEPLOY_SHA256}  linuxdeploy.AppImage" | sha256sum -c - \
    && chmod +x linuxdeploy.AppImage && ./linuxdeploy.AppImage --appimage-extract >/dev/null && mv squashfs-root linuxdeploy \
    && curl -fsSLo appimagetool.AppImage "https://github.com/AppImage/appimagetool/releases/download/${APPIMAGETOOL}/appimagetool-x86_64.AppImage" \
    && echo "${APPIMAGETOOL_SHA256}  appimagetool.AppImage" | sha256sum -c - \
    && chmod +x appimagetool.AppImage && ./appimagetool.AppImage --appimage-extract >/dev/null && mv squashfs-root appimagetool \
    && rm -f *.AppImage \
    && curl -fsSLo uv.tar.gz "https://github.com/astral-sh/uv/releases/download/${UV}/uv-x86_64-unknown-linux-gnu.tar.gz" \
    && echo "${UV_SHA256}  uv.tar.gz" | sha256sum -c - \
    && tar xzf uv.tar.gz && mv uv-x86_64-unknown-linux-gnu/uv /usr/local/bin/uv && rm -rf uv.tar.gz uv-x86_64-unknown-linux-gnu
